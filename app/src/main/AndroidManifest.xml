<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick Lock — privacy-first double-tap screen-lock widget.

  SECURITY NOTES (auditable):
   * The ONLY permission requested is VIBRATE (normal/install-time, used for the
     lock confirmation buzz). There is deliberately NO:
       - INTERNET / ACCESS_NETWORK_STATE  -> the app physically cannot send data anywhere
   * The OPTIONAL accessibility service (power-button lock, off until the user turns
     it on) is configured blind: canRetrieveWindowContent=false and no event types,
     so it cannot read the screen, OTPs, notifications or anything else.
       - SYSTEM_ALERT_WINDOW               -> no floating overlay over other apps
       - WAKE_LOCK / FOREGROUND_SERVICE / RECEIVE_BOOT_COMPLETED -> zero battery cost
   * allowBackup=false + full data-extraction excludes -> settings never leave the device
   * Every component declares android:exported explicitly (required on API 31+).
   * The widget receiver verifies a per-install secret token on its custom tap
     action, so no other app can forge a "lock" broadcast.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Normal permission, granted at install time, never prompts the user.
         Used only for a short vibration when the screen locks. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- NO NETWORK, EVER. Android only lets an app open sockets if it holds the
         network permission (enforced by the kernel, not just the framework), so
         without it nothing in this process can reach the internet — even code an
         attacker somehow got to run inside the app. tools:node="remove" strips
         these from the final APK even if a future library dependency tries to add
         them through manifest merging; CI also inspects the built APK. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" tools:node="remove" />

    <application
        android:name=".QuickLockApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/app_description"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickLock">

        <!-- Launcher entry: settings & setup. FLAG_SECURE is set in code so the
             app UI can never appear in screenshots or screen recordings. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Static app shortcut: long-press the app icon -> "Lock screen". -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Translucent, no-UI activity used by the static shortcut. It only calls
             lockNow(); it verifies the calling package before doing so, and it is
             excluded from recents with noHistory so it leaves no trace. -->
        <activity
            android:name=".LockNowActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.QuickLock.Translucent">
            <intent-filter>
                <action android:name="com.solerunner26.lockscreenwidget.action.LOCK_NOW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget. Exported is mandatory for app widgets. The custom
             WIDGET_TAP action has no intent-filter (it is only ever delivered as an
             explicit, immutable PendingIntent) and carries a per-install secret
             token that is verified in code, so other apps cannot forge a tap. -->
        <receiver
            android:name=".LockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_DELETED" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_OPTIONS_CHANGED" />
                <action android:name="android.appwidget.action.APPWIDGET_RESTORED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lock_widget_info" />
        </receiver>

        <!-- Device admin receiver. Requests ONLY the force-lock policy: the app can
             lock the screen and nothing else. It cannot read the screen, wipe data,
             change passwords, or see any user content. Bound with BIND_DEVICE_ADMIN
             so only the system can bind it. Revocable by the user at any time.
             label/description make the app show up properly in the system
             "Device admin apps" list. -->
        <receiver
            android:name=".LockDeviceAdminReceiver"
            android:description="@string/admin_receiver_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <!-- REQUIRED: Settings ("Device admin apps" list) and the system
                 activation dialog (ACTION_ADD_DEVICE_ADMIN) only accept receivers
                 that resolve for DEVICE_ADMIN_ENABLED. Without this filter the app
                 is silently missing from the list and "Activate" does nothing. -->
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
        </receiver>

        <!-- OPTIONAL power-button lock: locks like the power button so fingerprint
             unlock keeps working (device-admin lockNow forces the PIN). Bound only by
             the system (BIND_ACCESSIBILITY_SERVICE). Blind by configuration — see
             res/xml/lock_accessibility_service.xml. -->
        <service
            android:name=".LockAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_accessibility_service" />
        </service>

        <!-- Optional Quick Settings tile ("Lock screen"). Bound with
             BIND_QUICK_SETTINGS_TILE so only the system can bind it. The service is
             started by the system only while the tile is being used — it never runs
             in the background on its own. -->
        <service
            android:name=".LockTileService"
            android:exported="true"
            android:icon="@drawable/ic_lock_widget"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
